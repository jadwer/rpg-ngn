{
  "name": "mobile",
  "version": "0.1.0",
  "description": "Superficie del jugador en Expo: mesa en linea contra rpg-ngn-api (login por token, polling, respuesta y cierre de turno) y lectura sin conexion del pack piloto; vistas narrativa y dialogo, fichas en modal y narracion por voz",
  "license": "UNLICENSED",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle-pack": "tsx scripts/bundle-pack.ts",
    "doctor": "expo-doctor",
    "smoke-api": "tsx scripts/play-turn.mts"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/crimson-pro": "^0.4.2",
    "@rpg-ngn/api-client": "workspace:*",
    "@rpg-ngn/campaign": "workspace:*",
    "@rpg-ngn/content": "workspace:*",
    "@rpg-ngn/core": "workspace:*",
    "@rpg-ngn/rules": "workspace:*",
    "@rpg-ngn/ui-logic": "workspace:*",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-secure-store": "~57.0.3",
    "expo-speech": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0"
  }
}
