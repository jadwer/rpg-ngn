# A donde el proxy de Next reenvia /api/* y contra que API entran /auth/* (lado servidor).
# Sin esto: la API local en 8010. El token de la sesion vive en la cookie httpOnly rpg_session.
API_PROXY_TARGET=http://127.0.0.1:8010

# URL de la API que la pantalla de acceso propone por defecto (lado navegador).
# Vacio o ausente: el propio origen de la web (proxy con cookie, sin CORS). Otra URL
# es "modo directo": token en localStorage y CORS_ALLOWED_ORIGINS en esa API.
# NEXT_PUBLIC_API_URL=http://192.168.100.11:8010
