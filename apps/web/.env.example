# A donde reenvia Next las peticiones a /api/* (lado servidor). Sin esto: la API local en 8010.
API_PROXY_TARGET=http://127.0.0.1:8010

# URL de la API que la pantalla de acceso propone por defecto (lado navegador).
# Vacio o ausente: el propio origen de la web, que la reenvia por el proxy de arriba.
# NEXT_PUBLIC_API_URL=http://192.168.100.11:8010
