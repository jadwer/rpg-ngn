# Copia a .env para desarrollo. Node lo carga con --env-file-if-exists; en
# produccion estas variables van en el EnvironmentFile de systemd.
ENGINE_TOKEN=cambia-esto-y-ponlo-igual-en-rpg-ngn-api
HOST=0.0.0.0
PORT=3100
# PACKS_DIR=/ruta/a/content/packs

# Timeout de cada llamada al proveedor de LLM (ms). Un modelo local en una
# maquina chica tarda de 60 a 120 s por turno.
# PROVIDER_TIMEOUT_MS=180000
