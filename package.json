{
  "name": "rpg-ngn",
  "private": true,
  "type": "module",
  "description": "Motor agnostico para campanas de rol de mesa dirigidas por un DM asistido por IA",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:web": "pnpm --filter web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "validate": "pnpm --filter @rpg-ngn/validate run validate",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm validate && pnpm build:web",
    "clean": "pnpm -r exec rm -rf dist coverage .next"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
