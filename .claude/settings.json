{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\" postedit",
            "timeout": 20,
            "statusMessage": "Verificando reglas del repo"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\" stop",
            "timeout": 30,
            "statusMessage": "Barrido final de verificacion"
          }
        ]
      }
    ]
  }
}
