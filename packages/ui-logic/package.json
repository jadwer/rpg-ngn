{
  "name": "@rpg-ngn/ui-logic",
  "version": "0.1.0",
  "description": "Logica de UI compartida sin React: bloques tipados de un turno, vistas narrativa y dialogo, velado de fichas y cola de TTS por bloques",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rpg-ngn/campaign": "workspace:*",
    "@rpg-ngn/content": "workspace:*",
    "@rpg-ngn/core": "workspace:*"
  },
  "devDependencies": {
    "@rpg-ngn/rules": "workspace:*",
    "@types/node": "^22.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
