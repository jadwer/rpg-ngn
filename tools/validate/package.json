{
  "name": "@rpg-ngn/validate",
  "version": "0.1.0",
  "private": true,
  "description": "Valida content packs y logs de campaña contra los schemas de @rpg-ngn/content",
  "type": "module",
  "bin": {
    "rpg-validate": "./src/cli.ts"
  },
  "scripts": {
    "validate": "tsx src/cli.ts --root ../..",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rpg-ngn/content": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
